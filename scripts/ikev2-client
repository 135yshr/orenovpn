#!/usr/bin/env bash
#
# ikev2-client : orenovpn の IKEv2/IPsec クライアント管理ツール
#
#   ikev2-client add <name>      クライアント証明書を発行し .mobileconfig を生成
#   ikev2-client remove <name>   クライアントを削除
#   ikev2-client list            クライアント一覧・接続状況
#   ikev2-client show <name>     .mobileconfig の場所と導入手順を表示
#
# iPhone/macOS の標準VPN（アプリ不要）で接続するための構成プロファイルを作る。
# サーバー上で root（sudo）で実行する。
#
set -euo pipefail

ENV_FILE=/etc/orenovpn/orenovpn.env
# shellcheck disable=SC1090
source "$ENV_FILE"

PKI=/etc/orenovpn/pki
CLIENT_DIR=/etc/orenovpn/clients
CA_CN="orenovpn CA"
SERVER_IP="${SERVER_IP:-${WG_ENDPOINT_IP:-}}"
# 証明書失効(CRL)が有効なら発行を openssl ca 経由にし、remove で失効させる（既定 true）。
ENABLE_CERT_REVOCATION="${ENABLE_CERT_REVOCATION:-true}"

mkdir -p "$CLIENT_DIR"; umask 077
die() { echo "エラー: $*" >&2; exit 1; }

# クライアントの作成/削除をメール通知する（不在・失敗でも処理は続行する）。
NOTIFY=/usr/local/sbin/orenovpn-notify
notify_client() {
  [ -x "$NOTIFY" ] || return 0
  "$NOTIFY" client-change "$@" || true
}

[ "$(id -u)" -eq 0 ] || die "root 権限で実行してください（sudo）"
[ -n "$SERVER_IP" ] || die "SERVER_IP を特定できません（setup.sh 実行後に再試行してください）"

cmd_add() {
  local name="${1:-}" quiet="${2:-}"
  [ -n "$name" ] || die "クライアント名を指定してください"
  [[ "$name" =~ ^[A-Za-z0-9_-]+$ ]] || die "クライアント名は英数字・ハイフン・アンダースコアのみ"
  [ -f "${CLIENT_DIR}/${name}.mobileconfig" ] && die "クライアント '${name}' は既に存在します"

  # クライアント鍵・証明書（CA 署名, clientAuth）
  # SAN: iOS は mobileconfig の LocalIdentifier("iphone"等) を ID_FQDN 型で送るため、
  # 証明書には dNSName を含める必要がある（無いと strongSwan が
  # "no trusted public key found" で AUTH_FAILED になる）。email も残し両対応にする。
  local extf; extf="$(mktemp)"
  printf 'basicConstraints=critical,CA:FALSE\nkeyUsage=critical,digitalSignature\nextendedKeyUsage=clientAuth\nsubjectAltName=DNS:%s,email:%s\nsubjectKeyIdentifier=hash\nauthorityKeyIdentifier=keyid,issuer\n' "$name" "$name" > "$extf"
  openssl genrsa -out "${PKI}/${name}-key.pem" 4096 2>/dev/null
  openssl req -new -key "${PKI}/${name}-key.pem" -subj "/CN=${name}" -out "${PKI}/${name}.csr" 2>/dev/null
  if [ "${ENABLE_CERT_REVOCATION}" = "true" ] && [ -f "${PKI}/ca.cnf" ]; then
    # openssl ca 方式: index.txt に登録され、後で失効(CRL)できる
    openssl ca -batch -notext -config "${PKI}/ca.cnf" -in "${PKI}/${name}.csr" \
      -out "${PKI}/${name}-cert.pem" -days 3650 -extfile "$extf" 2>/dev/null \
      || { rm -f "$extf"; die "証明書の発行に失敗しました（openssl ca）"; }
  else
    openssl x509 -req -in "${PKI}/${name}.csr" -CA "${PKI}/ca-cert.pem" -CAkey "${PKI}/ca-key.pem" \
      -CAcreateserial -days 3650 -sha256 -extfile "$extf" \
      -out "${PKI}/${name}-cert.pem" 2>/dev/null \
      || { rm -f "$extf"; die "証明書の発行に失敗しました"; }
  fi
  rm -f "${PKI}/${name}.csr" "$extf"

  # PKCS12（鍵+証明書+CA）。プロファイル内に埋め込むためのパスワードを生成。
  # ⚠️ OpenSSL 3.x 既定(AES-256/PBKDF2)の PKCS12 は Apple のプロファイル
  #   インストーラが読めず "certificate could not be verified" になる。
  #   Apple 互換の旧来形式(3DES/SHA1)で出力する必要がある(-legacy)。
  local p12pass; p12pass="$(openssl rand -hex 12)"
  openssl pkcs12 -export -legacy -macalg sha1 \
    -keypbe PBE-SHA1-3DES -certpbe PBE-SHA1-3DES \
    -inkey "${PKI}/${name}-key.pem" -in "${PKI}/${name}-cert.pem" \
    -certfile "${PKI}/ca-cert.pem" -passout "pass:${p12pass}" -out "${PKI}/${name}.p12" 2>/dev/null

  # base64（CA は DER 形式）
  local ca_b64 p12_b64 u_top u_ca u_p12 u_vpn
  ca_b64="$(openssl x509 -in "${PKI}/ca-cert.pem" -outform der | base64 -w0)"
  p12_b64="$(base64 -w0 < "${PKI}/${name}.p12")"
  u_top="$(uuidgen)"; u_ca="$(uuidgen)"; u_p12="$(uuidgen)"; u_vpn="$(uuidgen)"

  cat > "${CLIENT_DIR}/${name}.mobileconfig" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>PayloadDisplayName</key><string>orenovpn (${name})</string>
  <key>PayloadIdentifier</key><string>jp.orenovpn.${name}</string>
  <key>PayloadType</key><string>Configuration</string>
  <key>PayloadUUID</key><string>${u_top}</string>
  <key>PayloadVersion</key><integer>1</integer>
  <key>PayloadContent</key>
  <array>
    <dict>
      <key>PayloadType</key><string>com.apple.security.root</string>
      <key>PayloadIdentifier</key><string>jp.orenovpn.ca</string>
      <key>PayloadUUID</key><string>${u_ca}</string>
      <key>PayloadVersion</key><integer>1</integer>
      <key>PayloadDisplayName</key><string>orenovpn CA</string>
      <key>PayloadCertificateFileName</key><string>ca.cer</string>
      <key>PayloadContent</key>
      <data>${ca_b64}</data>
    </dict>
    <dict>
      <key>PayloadType</key><string>com.apple.security.pkcs12</string>
      <key>PayloadIdentifier</key><string>jp.orenovpn.cert.${name}</string>
      <key>PayloadUUID</key><string>${u_p12}</string>
      <key>PayloadVersion</key><integer>1</integer>
      <key>PayloadDisplayName</key><string>${name}</string>
      <key>PayloadCertificateFileName</key><string>${name}.p12</string>
      <key>Password</key><string>${p12pass}</string>
      <key>PayloadContent</key>
      <data>${p12_b64}</data>
    </dict>
    <dict>
      <key>PayloadType</key><string>com.apple.vpn.managed</string>
      <key>PayloadIdentifier</key><string>jp.orenovpn.vpn.${name}</string>
      <key>PayloadUUID</key><string>${u_vpn}</string>
      <key>PayloadVersion</key><integer>1</integer>
      <key>PayloadDisplayName</key><string>orenovpn</string>
      <key>UserDefinedName</key><string>orenovpn</string>
      <key>VPNType</key><string>IKEv2</string>
      <key>IKEv2</key>
      <dict>
        <key>RemoteAddress</key><string>${SERVER_IP}</string>
        <key>RemoteIdentifier</key><string>${SERVER_IP}</string>
        <key>LocalIdentifier</key><string>${name}</string>
        <key>AuthenticationMethod</key><string>Certificate</string>
        <key>PayloadCertificateUUID</key><string>${u_p12}</string>
        <key>ServerCertificateIssuerCommonName</key><string>${CA_CN}</string>
        <key>ExtendedAuthEnabled</key><integer>0</integer>
        <key>IKESecurityAssociationParameters</key>
        <dict>
          <key>EncryptionAlgorithm</key><string>AES-256</string>
          <key>IntegrityAlgorithm</key><string>SHA2-256</string>
          <key>DiffieHellmanGroup</key><integer>14</integer>
        </dict>
        <key>ChildSecurityAssociationParameters</key>
        <dict>
          <key>EncryptionAlgorithm</key><string>AES-256</string>
          <key>IntegrityAlgorithm</key><string>SHA2-256</string>
          <key>DiffieHellmanGroup</key><integer>14</integer>
        </dict>
      </dict>
    </dict>
  </array>
</dict>
</plist>
EOF
  chmod 600 "${CLIENT_DIR}/${name}.mobileconfig"

  # 証明書のシリアルも載せる。失効(CRL)の突き合わせと、「新規 VPN 接続を検知
  # （IKEv2）」が示す証明書 ID との対応を後から追えるようにするため。
  local serial
  serial="$(openssl x509 -in "${PKI}/${name}-cert.pem" -noout -serial 2>/dev/null \
    | cut -d= -f2 || true)"
  notify_client added "$name" "  証明書 ID: CN=${name}
  証明書シリアル: ${serial:-（取得できず）}
  構成プロファイル: ${CLIENT_DIR}/${name}.mobileconfig
  ⚠️ .mobileconfig は p12 の復号パスワードを平文で含みます（＝資格情報そのもの）。"

  if [ "$quiet" != "--quiet" ]; then
    echo "クライアント '${name}' の構成プロファイルを作成しました。"
    echo
    cmd_show "$name"
  fi
}

cmd_remove() {
  local name="${1:-}"
  [ -n "$name" ] || die "クライアント名を指定してください"
  [ -f "${CLIENT_DIR}/${name}.mobileconfig" ] || die "クライアント '${name}' は存在しません"

  # 失効が有効で、かつこの証明書が CA DB(index.txt)に登録済みなら失効させる。
  # （openssl ca 方式で発行された証明書のみ失効可能。旧 x509 発行分は revoke 不可）
  local revoked=0 reason="" out="" serial=""
  # 失効前に控える（成功時は原本を消すため、後からは取得できない）
  if [ -f "${PKI}/${name}-cert.pem" ]; then
    serial="$(openssl x509 -in "${PKI}/${name}-cert.pem" -noout -serial 2>/dev/null \
      | cut -d= -f2 || true)"
  fi
  if [ "${ENABLE_CERT_REVOCATION}" != "true" ] || [ ! -f "${PKI}/ca.cnf" ]; then
    reason="失効機能が無効（enable_cert_revocation=false で構築されている）"
  elif [ ! -f "${PKI}/${name}-cert.pem" ]; then
    reason="証明書の原本 ${PKI}/${name}-cert.pem が無く、失効対象を特定できない"
  elif out="$(openssl ca -config "${PKI}/ca.cnf" -revoke "${PKI}/${name}-cert.pem" 2>&1)" \
       || printf '%s' "$out" | grep -qi 'already revoked'; then
    # 失効登録は完了している（今回 or 以前の実行で）。CRL の生成・配置へ進む。
    # 「既に失効済み」を成功として扱わないと、CRL 生成だけ失敗したときに
    # 再実行しても -revoke で止まり、CRL を publish できないまま詰む。
    if out="$(openssl ca -gencrl -config "${PKI}/ca.cnf" -out "${PKI}/crl.pem" 2>&1)"; then
      mkdir -p /etc/swanctl/x509crl
      install -m644 "${PKI}/crl.pem" /etc/swanctl/x509crl/orenovpn.crl
      swanctl --load-all >/dev/null 2>&1 || true
      revoked=1
    else
      reason="失効登録は済んだが CRL の生成に失敗（証明書を残すので make remove を再実行すれば復旧できる）
   詳細: $(printf '%s' "$out" | tail -n 2 | tr '\n' ' ')"
    fi
  else
    reason="openssl ca -revoke に失敗（失効を有効化する前に発行された証明書は CA DB 未登録のため失効できない）
   詳細: $(printf '%s' "$out" | tail -n 2 | tr '\n' ' ')"
  fi

  # 失効できていない場合は証明書の原本を消さない（消すと将来も失効できなくなる）。
  rm -f "${CLIENT_DIR}/${name}.mobileconfig" \
        "${PKI}/${name}-key.pem" "${PKI}/${name}.p12"

  # 通知には「失効できたか」を必ず載せる。失効できていない場合は配布物を消しても
  # 手元に残った証明書で最長 10 年つなげてしまい、削除＝遮断ではないため。
  if [ "$revoked" = 1 ]; then
    rm -f "${PKI}/${name}-cert.pem"
    notify_client removed "$name" "  証明書 ID: CN=${name}
  証明書シリアル: ${serial:-（取得できず）}
  失効(CRL): 済み — 以後この証明書では新規接続できません。
  ※ 確立中のセッションは残ります。即時に切るなら
     sudo swanctl --terminate --ike orenovpn"
    echo "クライアント '${name}' を削除し、証明書を失効(CRL)しました。"
    echo "以後この証明書では新規接続できません（strongSwan が CRL で拒否）。"
    echo "⚠️ CRL は「新しい認証」時に効きます。確立中のセッションは残るため、確実に切るには:"
    echo "     sudo swanctl --list-sas                    # 現在の接続を確認"
    echo "     sudo swanctl --terminate --ike orenovpn    # 全接続を切断（正規端末は再接続が必要）"
  else
    notify_client removed "$name" "  証明書 ID: CN=${name}
  証明書シリアル: ${serial:-（取得できず）}
  ⚠️ 失効(CRL): 失敗 — 配布物は消えましたが、この証明書はまだ接続に使えます。
     理由: ${reason}
  対処: make doctor で失効機能の状態を確認し、有効化したうえで make remove を再実行"
    echo "クライアント '${name}' の配布物・秘密鍵を削除しました（証明書の原本は保持）。"
    echo "⚠️ これは接続アクセスの「失効」ではありません。理由: ${reason}"
    echo "   発行済みクライアント証明書は手元に残っていれば最長10年、接続に使用できます。"
    echo "   原本 ${PKI}/${name}-cert.pem は残してあるため、失効を有効化すれば後から失効できます。"
    echo "   今すぐ確実に止めるには CA と全クライアントの作り直しが必要です:"
    echo "     1) enable_cert_revocation = true にする（既定は true）"
    echo "     2) sudo rm -rf ${PKI} && sudo /usr/local/sbin/setup.sh"
    echo "     3) make client NAME=... で全端末を作り直し、古いプロファイルを端末から削除"
  fi
}

cmd_list() {
  echo "== 登録済みクライアント =="
  ls -1 "${CLIENT_DIR}"/*.mobileconfig 2>/dev/null | sed 's#.*/##; s/\.mobileconfig$//' || echo "（なし）"
  echo
  echo "== 現在の IPsec 接続 (swanctl) =="
  swanctl --list-sas 2>/dev/null || echo "（接続なし/未起動）"
}

cmd_show() {
  local name="${1:-}"
  [ -n "$name" ] || die "クライアント名を指定してください"
  local prof="${CLIENT_DIR}/${name}.mobileconfig"
  [ -f "$prof" ] || die "クライアント '${name}' の構成プロファイルが見つかりません"

  cat <<EOF
▼ iPhone / macOS への導入手順（アプリ不要・標準VPN）

構成プロファイル: ${prof}

1) このファイルを手元の端末に取得:
     scp -P ${SSH_PORT:-22} <user>@${SERVER_IP}:${prof} ./${name}.mobileconfig

2) 端末にインストール:
   - iPhone: ファイルを AirDrop/メール等で送り、開く →「設定」→
     「プロファイルがダウンロードされました」→ インストール
   - macOS: ダブルクリック →「システム設定」→「デバイス管理」→ インストール

3) 「設定」→「VPN」に "orenovpn" が追加される。トグルON で接続。

※ 証明書認証のためパスワード入力は不要です。
EOF
}

usage() {
  cat <<EOF
使い方: ikev2-client <コマンド> [引数]
  add <name>      クライアントを追加（.mobileconfig を生成）
  remove <name>   クライアントを削除
  list            一覧・接続状況
  show <name>     構成プロファイルの場所と導入手順を表示
EOF
}

case "${1:-}" in
  add)           shift; cmd_add "$@" ;;
  remove|rm|del) shift; cmd_remove "$@" ;;
  list|ls)       cmd_list ;;
  show)          shift; cmd_show "$@" ;;
  *)             usage; exit 1 ;;
esac
