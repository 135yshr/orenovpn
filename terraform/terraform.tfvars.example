# =============================================================================
# orenovpn 設定ファイル
#
# このファイルを terraform.tfvars にコピーして、自分の環境に合わせて編集する。
#     cp terraform.tfvars.example terraform.tfvars
#
# 最低限、以下 4 つを設定すれば動きます:
#   - conoha_tenant_name / conoha_user_name / conoha_password
#   - ssh_public_key
# それ以外はコメントアウトのままでOK（安全なデフォルト値が使われます）。
# =============================================================================

# --- ① ConoHa API 認証情報（必須）------------------------------------------
# コントロールパネル → API メニューから取得
conoha_tenant_name = "gnct00000000"
conoha_user_name   = "gncu00000000"
conoha_password    = "your-api-password-here"

# --- ② SSH 公開鍵（必須）----------------------------------------------------
# `ssh-keygen -t ed25519` で作った ~/.ssh/id_ed25519.pub の中身を貼り付け
ssh_public_key = "ssh-ed25519 AAAAC3Nza... your_comment"

# --- ③ サーバー構成（任意）--------------------------------------------------
# instance_name = "orenovpn"
# flavor_name   = "g2l-t-c1m512"        # 最安 512MB プラン
# image_name    = "vmi-debian-13.5-amd64"   # `make images` で正確名を確認
# volume_size   = 30                     # GB。512MBプランは30固定/上位プランは100等
# timezone      = "Asia/Tokyo"

# --- ④ SSH アクセス制御（任意・強く推奨）------------------------------------
# SSH は 22 番固定（ポート変更機能なし）。防御は鍵認証＋fail2ban が担う。
# admin_user = "vpnadmin"

# 自宅/オフィスの固定 IP に絞ると安全性が大きく向上する。
# 確認: `curl -4 ifconfig.co`
# allowed_ssh_cidr = ["203.0.113.10/32"]

# --- VPN プロトコル（任意）--------------------------------------------------
# "wireguard"（既定・高速/専用アプリ）または "ikev2"（iPhone/macOS標準VPNで
# アプリ不要・.mobileconfigワンタップ導入）
# vpn_protocol = "wireguard"

# --- ⑤ WireGuard（vpn_protocol="wireguard" のとき）-------------------------
# wg_port        = 51820
# wg_dns         = "1.1.1.1,1.0.0.1"     # 例: プライバシー重視なら "9.9.9.9"
# wg_enable_ipv6 = true
# wg_allowed_ips = "0.0.0.0/0,::/0"      # フルトンネル（全通信を VPN 経由）
# wg_clients     = ["phone", "laptop"]   # 初期作成するクライアント

# --- ⑥ セキュリティ強化（任意）----------------------------------------------
# enable_fail2ban     = true
# enable_auto_updates = true

# --- QR 配布 / 証明書失効（任意）--------------------------------------------
# enable_profile_download = true          # make serve-profile 用に配信ポートを SG へ宣言
# profile_port            = 443           # 配信ポート（既定 443。IPv4v6-Web が 80/443 を開く）
# randomize_profile_port  = true          # 配信ポートを apply 時にランダム(20000-60000)決定
# enable_cert_revocation  = true          # IKEv2 証明書の失効(CRL)。既定 true（false は漏洩時に止められない）

# --- アクセス先の記録（任意・既定 OFF。詳細は docs/ALERTING.md）--------------
# URL は TLS 暗号化のため記録できない。残るのは宛先IP・ポート・ドメイン名まで。
# enable_access_log       = true          # 接続先(宛先IP/ポート)を記録（make access-log）
# enable_dns_logging      = true          # ドメイン名を記録（unbound を立てる。make dns-log）
# log_retention_days      = 14            # 記録の保存日数（journald 上限 1G）

# --- 通信監視・警告（任意。詳細は docs/ALERTING.md）-------------------------
# enable_traffic_alert = true
# alert_email          = "you@example.com"
# 送信方式: relay=外部SMTPへリレー（既定）/ local=VPN上の dma が宛先MXへ直接配送
# smtp_mode            = "local"
# mail_from            = "orenovpn@vpn.example.com" # local では自ドメイン必須(SPF)
# relay を使う場合のみ（smtp_password は state に平文で残る点に注意）:
# smtp_host            = "smtp.gmail.com"
# smtp_port            = 587
# smtp_user            = "you@example.com"
# smtp_password        = "CHANGE_ME_APP_PASSWORD"
# alert_blocklist_url  = "https://example.com/malicious-ips.txt" # 1行1IP/CIDR
